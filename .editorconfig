# EditorConfig helps maintain consistent coding styles across different editors and IDEs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.{html,css,scss}]
indent_size = 2

[*.{ts,js}]
indent_size = 2

[*.php]
indent_size = 4