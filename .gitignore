# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
/node_modules/
/yarn.lock

# Lockfiles SHOULD be commitowane (deterministyczne buildy)
# package-lock.json i composer.lock są commitowane celowo

# Environment files
/.env
/backend/.env
/backend/.env.development
/backend/.env.production
/frontend/.env
/frontend/.env.development
/frontend/.env.production

# Backend vendor (Composer)
/backend/vendor/

# Backend private storage (uploadowane dokumenty pracowników — poza document root)
/backend/storage/

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
