# === Baza danych ===
DATABASE_HOST=XXX
DATABASE_NAME=XXX
DATABASE_LOGIN=XXX
DATABASE_PASSWORD=XXX

# === Domeny (development) ===
API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# === JWT ===
# UWAGA: W produkcji użyaj silny sekret: openssl rand -base64 48
# Backend odrzuci start, gdy w produkcji JWT_SECRET < 32 znaki lub równe wartości dev.
JWT_SECRET=dev-secret-key-change-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# === APP_KEY (szyfrowanie danych at-rest AES-256-GCM) ===
# W produkcji: openssl rand -base64 32
APP_KEY=

# === SMTP (powiadomienia e-mail) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pbs.local
SMTP_FROM_NAME=Port Baltic Shipping

# === Debug ===
# W produkcji MUSI być false — backend wymusi to w bootstrapie.
APP_DEBUG=true
