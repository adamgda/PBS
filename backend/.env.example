# === Baza danych ===
DATABASE_HOST=XXX
DATABASE_NAME=XXX
DATABASE_LOGIN=XXX
DATABASE_PASSWORD=XXX
# Timeout połączenia z MySQL (sekundy) — dokumentacja 14.5. Domyślnie 5 s.
DB_TIMEOUT=5
# Connection pooling (PDO persistent) — dokumentacja 14.4. Domyślnie false.
DB_PERSISTENT=false

# === Cache (dokumentacja 14.2) ===
# Wartości: apcu (produkcja, wymaga ext-apcu) | file (fallback) | array (dev/testy)
CACHE_DRIVER=array

# === Monitorowanie / wydajność (dokumentacja 14.8) ===
# slow_query_log: LONG_QUERY_TIME=0.1 na staging/produkcji (wymaga konfiguracji MySQL,
# poza repozytorium — ustawiane na serwerze DB). Metryki API logowane przez
# MonitoringMiddleware do stderr w formacie JSON (do agregacji przez Grafana/Loki).

# === Domeny (development) ===
API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# === JWT ===
# UWAGA: W produkcji użyaj silny sekret: openssl rand -base64 48
# Backend odrzuci start, gdy w produkcji JWT_SECRET < 32 znaki lub równe wartości dev.
JWT_SECRET=dev-secret-key-change-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Algorytm podpisywania JWT: HS256 (dev) / RS256 (produkcja). W produkcji wymagane klucze RSA (2048-bit).
JWT_ALGORITHM=HS256
# Klucze RSA (tylko RS256) — wartości wieloliniowe ujęte w cudzysłów (obsługa w Config::parseEnvFile).
# Generowanie: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"

# === APP_KEY (szyfrowanie danych at-rest AES-256-GCM) ===
# W produkcji: openssl rand -base64 32
APP_KEY=

# === CSRF ===
# Wymuszaj X-CSRF-Token dla metod mutujących (produkcja rekomendowana). Domyślnie false.
CSRF_ENFORCE=false

# === SMTP (powiadomienia e-mail) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pbs.local
SMTP_FROM_NAME=Port Baltic Shipping

# === Debug ===
# W produkcji MUSI być false — backend wymusi to w bootstrapie.
APP_DEBUG=true
